 style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fbefff;strokeColor=#8250df;" vertex="1" parent="1"><mxGeometry x="1125.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190.0" y="120" as="sourcePoint"/><mxPoint x="1190.0" y="1215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="Kafka" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fbefff;strokeColor=#8250df;" vertex="1" parent="1"><mxGeometry x="1280.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345.0" y="120" as="sourcePoint"/><mxPoint x="1345.0" y="1215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="CDC&lt;br&gt;(Debezium)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fbefff;strokeColor=#8250df;" vertex="1" parent="1"><mxGeometry x="1435.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500.0" y="120" as="sourcePoint"/><mxPoint x="1500.0" y="1215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="Operational DB&lt;br&gt;(SQL)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff8c5;strokeColor=#9a6700;" vertex="1" parent="1"><mxGeometry x="1590.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1655.0" y="120" as="sourcePoint"/><mxPoint x="1655.0" y="1215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="Vector DB&lt;br&gt;(not needed for MVP)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#f6f8fa;strokeColor=#8c959f;fontColor=#8c959f;dashed=1;" vertex="1" parent="1"><mxGeometry x="1745.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#8c959f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1810.0" y="120" as="sourcePoint"/><mxPoint x="1810.0" y="1215" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Use case: Homepage recommendations for a returning user&lt;/b&gt; &amp;nbsp;|&amp;nbsp; Option A (chosen): precomputed top-K in CDP + real-time re-rank with fresh session features &amp;nbsp;|&amp;nbsp; P95 target: 150 ms (server side)" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1860" height="36" as="geometry"/></mxCell><mxCell id="c28" value="" style="rounded=0;fillColor=#1f6feb;opacity=8;strokeColor=#1f6feb;strokeOpacity=40;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="1870" height="470" as="geometry"/></mxCell><mxCell id="c29" value="A. REAL-TIME REQUEST PATH (the user is waiting, P95 ≤ 150 ms)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1f6feb;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="144" width="900" height="22" as="geometry"/></mxCell><mxCell id="c30" value="1. GET /home (JWT, HTTPS)  [10 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="185" as="sourcePoint"/><mxPoint x="260.0" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="2. auth OK, rate-limit, route  [5 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="223" as="sourcePoint"/><mxPoint x="415.0" y="223" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="3. GET /recs?user=u&amp;k=20  (timeout 100 ms)  [5 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="261" as="sourcePoint"/><mxPoint x="570.0" y="261" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="4a. GET top-200 candidates(u)  [10 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="303" as="sourcePoint"/><mxPoint x="880.0" y="303" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="4b. GET online features(u) — parallel with 4a  [10 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="337" as="sourcePoint"/><mxPoint x="725.0" y="337" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="session clicks, cart, recent buys" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.0" y="371" as="sourcePoint"/><mxPoint x="570.0" y="371" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="candidates + segment" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880.0" y="405" as="sourcePoint"/><mxPoint x="570.0" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="rounded=0;fillColor=#1f6feb;strokeColor=#1f6feb;opacity=60;" vertex="1" parent="1"><mxGeometry x="562.0" y="437" width="16" height="26" as="geometry"/></mxCell><mxCell id="c38" value="5. re-rank 200 → 20, drop bought / out-of-stock  [30 ms]" style="text;html=1;fontSize=11;fontColor=#1f6feb;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="582.0" y="435" width="190" height="30" as="geometry"/></mxCell><mxCell id="c39" value="6. 20 item IDs + reason codes" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="485" as="sourcePoint"/><mxPoint x="415.0" y="485" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="" style="rounded=0;fillColor=#1f6feb;strokeColor=#1f6feb;opacity=60;" vertex="1" parent="1"><mxGeometry x="407.0" y="517" width="16" height="26" as="geometry"/></mxCell><mxCell id="c41" value="7. hydrate product cards from catalog cache  [15 ms]" style="text;html=1;fontSize=11;fontColor=#1f6feb;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="427.0" y="515" width="190" height="30" as="geometry"/></mxCell><mxCell id="c42" value="8. homepage JSON (via gateway)  [10 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="565" as="sourcePoint"/><mxPoint x="105.0" y="565" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="&lt;b&gt;Fallback (degraded mode):&lt;/b&gt; if step 3 times out or the user has no top-K row, the E-commerce service serves the cached &lt;i&gt;popular-in-segment&lt;/i&gt; list from CDP. The homepage never blocks on ML." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1f6feb;" vertex="1" parent="1"><mxGeometry x="975.0" y="195" width="470" height="62" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;Never in the request path:&lt;/b&gt; Operational DB (except normal catalog cache misses), Kafka, Flink, Airflow, Vector DB." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#1f6feb;" vertex="1" parent="1"><mxGeometry x="975.0" y="270" width="470" height="46" as="geometry"/></mxCell><mxCell id="c45" value="" style="rounded=0;fillColor=#d4740b;opacity=8;strokeColor=#d4740b;strokeOpacity=40;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1870" height="285" as="geometry"/></mxCell><mxCell id="c46" value="B1. BACKGROUND: NEAR-REAL-TIME INGESTION (seconds; nobody waits)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#d4740b;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="634" width="900" height="22" as="geometry"/></mxCell><mxCell id="c47" value="b1. INSERT order / UPDATE cart (normal transaction)" style="endArrow=block;endFill=1;html=1;strokeColor=#d4740b;strokeWidth=2;fontColor=#d4740b;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="675" as="sourcePoint"/><mxPoint x="1655.0" y="675" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="b2. read WAL / binlog (no SELECTs on the DB)" style="endArrow=block;endFill=1;html=1;strokeColor=#d4740b;strokeWidth=2;fontColor=#d4740b;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1655.0" y="713" as="sourcePoint"/><mxPoint x="1500.0" y="713" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c49" value="b3. publish orders, cart_items topics" style="endArrow=block;endFill=1;html=1;strokeColor=#d4740b;strokeWidth=2;fontColor=#d4740b;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500.0" y="751" as="sourcePoint"/><mxPoint x="1345.0" y="751" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="b0. MISSING COMPONENT: clickstream collector (views/clicks are not in the DB, so CDC can't see them)" style="endArrow=block;endFill=1;html=1;strokeColor=#cf222e;strokeWidth=2;fontColor=#cf222e;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="789" as="sourcePoint"/><mxPoint x="1345.0" y="789" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c51" value="b4. consume events" style="endArrow=block;endFill=1;html=1;strokeColor=#d4740b;strokeWidth=2;fontColor=#d4740b;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1345.0" y="827" as="sourcePoint"/><mxPoint x="1190.0" y="827" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c52" value="b5. upsert online features + append to offline store" style="endArrow=block;endFill=1;html=1;strokeColor=#d4740b;strokeWidth=2;fontColor=#d4740b;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190.0" y="865" as="sourcePoint"/><mxPoint x="725.0" y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="rounded=0;fillColor=#8250df;opacity=8;strokeColor=#8250df;strokeOpacity=40;" vertex="1" parent="1"><mxGeometry x="20" y="935" width="1870" height="270" as="geometry"/></mxCell><mxCell id="c54" value="B2. BACKGROUND: BATCH (Airflow DAG, nightly + hourly refresh of top-K)" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#8250df;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="939" width="900" height="22" as="geometry"/></mxCell><mxCell id="c55" value="c1. build point-in-time training set (offline store)" style="endArrow=block;endFill=1;html=1;strokeColor=#8250df;strokeWidth=2;fontColor=#8250df;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="980" as="sourcePoint"/><mxPoint x="725.0" y="980" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="c2. retrain + register ranking model (nightly)" style="endArrow=block;endFill=1;html=1;strokeColor=#8250df;strokeWidth=2;fontColor=#8250df;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1018" as="sourcePoint"/><mxPoint x="570.0" y="1018" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="c3. batch-score active users → top-200 each" style="endArrow=block;endFill=1;html=1;strokeColor=#8250df;strokeWidth=2;fontColor=#8250df;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1056" as="sourcePoint"/><mxPoint x="570.0" y="1056" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="c4. write top-200 per user + popular-per-segment fallback" style="endArrow=block;endFill=1;html=1;strokeColor=#8250df;strokeWidth=2;fontColor=#8250df;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1094" as="sourcePoint"/><mxPoint x="880.0" y="1094" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c59" value="c5. (optional) item-embedding ANN — in-memory in the job for MVP" style="endArrow=block;endFill=1;html=1;strokeColor=#8c959f;strokeWidth=2;fontColor=#8c959f;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="1132" as="sourcePoint"/><mxPoint x="1810.0" y="1132" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#1f6feb'&gt;━━ &lt;/font&gt;real-time request path&lt;br&gt;&lt;font color='#d4740b'&gt;━━ &lt;/font&gt;streaming ingestion (CDC → Kafka → Flink)&lt;br&gt;&lt;font color='#8250df'&gt;━━ &lt;/font&gt;batch (Airflow)&lt;br&gt;&lt;font color='#cf222e'&gt;┅┅ &lt;/font&gt;missing from the high-level view&lt;br&gt;&lt;font color='#8c959f'&gt;┅┅ &lt;/font&gt;not needed for this use case (MVP)&lt;br&gt;┅┅ dashed black/colour arrow = response" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f6f8fa;strokeColor=#57606a;" vertex="1" parent="1"><mxGeometry x="20" y="1235" width="330" height="130" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Over-engineering check&lt;/b&gt;&lt;br&gt;&lt;b&gt;Missing:&lt;/b&gt; clickstream collector (gateway endpoint → Kafka); model registry (MLflow) for c2; catalog cache in E-commerce svc; monitoring of recs CTR + staleness.&lt;br&gt;&lt;b&gt;Not needed:&lt;/b&gt; WhatsApp (outbound only, other use case); Vector DB (no real-time similarity search; batch job does ANN in memory); Flink is &lt;i&gt;justified&lt;/i&gt; only because session freshness matters, otherwise hourly Airflow would do." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f6f8fa;strokeColor=#cf222e;" vertex="1" parent="1"><mxGeometry x="370" y="1235" width="560" height="130" as="geometry"/></mxCell><mxCell id="c62" value="&lt;b&gt;Latency budget (P95, server side)&lt;/b&gt;&lt;br&gt;1 gateway+TLS 10 · 2 route 5 · 3 hop 5 · 4a∥4b 10 · 5 re-rank 30 · 7 hydrate 15 · 8 return 10&lt;br&gt;&lt;b&gt;= 85 ms&lt;/b&gt; + 65 ms headroom (GC, retries, Ramadan peak queueing) → &lt;b&gt;150 ms&lt;/b&gt; target.&lt;br&gt;Hard timeout on step 3 = 100 ms, then fallback list." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f6f8fa;strokeColor=#1f6feb;" vertex="1" parent="1"><mxGeometry x="950" y="1235" width="470" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="optionB" name="Option B (rejected) - real-time vector search"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Channel&lt;br&gt;(Web / App)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#ddf4ff;strokeColor=#1f6feb;" vertex="1" parent="1"><mxGeometry x="40.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="120" as="sourcePoint"/><mxPoint x="105.0" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#ddf4ff;strokeColor=#1f6feb;" vertex="1" parent="1"><mxGeometry x="195.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="120" as="sourcePoint"/><mxPoint x="260.0" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="E-commerce&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#ddf4ff;strokeColor=#1f6feb;" vertex="1" parent="1"><mxGeometry x="350.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="120" as="sourcePoint"/><mxPoint x="415.0" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="Recommendation&lt;br&gt;Engine" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#ddf4ff;strokeColor=#1f6feb;" vertex="1" parent="1"><mxGeometry x="505.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="120" as="sourcePoint"/><mxPoint x="570.0" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="Feature Store&lt;br&gt;(online | offline)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff8c5;strokeColor=#9a6700;" vertex="1" parent="1"><mxGeometry x="660.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.0" y="120" as="sourcePoint"/><mxPoint x="725.0" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="Operational DB&lt;br&gt;(SQL)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff8c5;strokeColor=#9a6700;" vertex="1" parent="1"><mxGeometry x="815.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880.0" y="120" as="sourcePoint"/><mxPoint x="880.0" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="Vector DB&lt;br&gt;(item embeddings)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff8c5;strokeColor=#9a6700;" vertex="1" parent="1"><mxGeometry x="970.0" y="60" width="130" height="60" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#57606a;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="120" as="sourcePoint"/><mxPoint x="1035.0" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c17" value="&lt;b&gt;Option B (rejected):&lt;/b&gt; build the user embedding and query the Vector DB on every homepage request" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1085" height="36" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=0;fillColor=#1f6feb;opacity=8;strokeColor=#1f6feb;strokeOpacity=40;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="1095" height="430" as="geometry"/></mxCell><mxCell id="c19" value="REAL-TIME REQUEST PATH" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#1f6feb;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="144" width="900" height="22" as="geometry"/></mxCell><mxCell id="c20" value="1. GET /home  [10 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="185" as="sourcePoint"/><mxPoint x="260.0" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="2. route  [5 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="223" as="sourcePoint"/><mxPoint x="415.0" y="223" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="3. GET /recs  [5 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="261" as="sourcePoint"/><mxPoint x="570.0" y="261" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c23" value="4. GET user features  [10 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="299" as="sourcePoint"/><mxPoint x="725.0" y="299" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="" style="rounded=0;fillColor=#1f6feb;strokeColor=#1f6feb;opacity=60;" vertex="1" parent="1"><mxGeometry x="562.0" y="331" width="16" height="26" as="geometry"/></mxCell><mxCell id="c25" value="5. encode user embedding (model call)  [20 ms]" style="text;html=1;fontSize=11;fontColor=#1f6feb;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="582.0" y="329" width="190" height="30" as="geometry"/></mxCell><mxCell id="c26" value="6. ANN top-200 similar items  [30–60 ms, grows with catalog + QPS]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="379" as="sourcePoint"/><mxPoint x="1035.0" y="379" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="candidates" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="417" as="sourcePoint"/><mxPoint x="570.0" y="417" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="" style="rounded=0;fillColor=#1f6feb;strokeColor=#1f6feb;opacity=60;" vertex="1" parent="1"><mxGeometry x="562.0" y="449" width="16" height="26" as="geometry"/></mxCell><mxCell id="c29" value="7. re-rank + filter  [30 ms]" style="text;html=1;fontSize=11;fontColor=#1f6feb;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="582.0" y="447" width="190" height="30" as="geometry"/></mxCell><mxCell id="c30" value="8. item IDs" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570.0" y="497" as="sourcePoint"/><mxPoint x="415.0" y="497" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c31" value="9. hydrate + return  [25 ms]" style="endArrow=block;endFill=1;html=1;strokeColor=#1f6feb;strokeWidth=2;fontColor=#1f6feb;fontSize=11;labelBackgroundColor=#ffffff;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="535" as="sourcePoint"/><mxPoint x="105.0" y="535" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;Why rejected&lt;/b&gt;&lt;br&gt;&lt;b&gt;Latency:&lt;/b&gt; 135–165 ms P95 before headroom: breaks the 150 ms target at peak (ANN tail latency rises with load).&lt;br&gt;&lt;b&gt;Cost:&lt;/b&gt; Vector DB cluster + embedding model sized for Ramadan peak QPS, 24/7. Option A pays for compute once per user per night, off-peak.&lt;br&gt;&lt;b&gt;Operational DB load:&lt;/b&gt; zero in both if features come via CDC; Option B adds a new hard runtime dependency (Vector DB down = no recs).&lt;br&gt;&lt;b&gt;What B does better:&lt;/b&gt; freshness (reacts to the click a second ago) and the long tail. &lt;b&gt;Revisit when:&lt;/b&gt; the catalog changes hourly, or offline A/B shows session-aware retrieval lifts CTR enough to pay for it." style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacing=8;fillColor=#f6f8fa;strokeColor=#cf222e;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="1085" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>